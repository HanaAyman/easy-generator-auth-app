NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/auth-app?retryWrites=true&w=majority
MONGODB_URI=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# The exact origin the frontend is served from (no wildcard - cookies require it)
CORS_ORIGIN=http://localhost:5173
